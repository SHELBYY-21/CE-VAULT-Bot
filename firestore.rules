rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Legacy (compat reads) — writes Admin SDK only ──
    match /admins/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /bank_accounts/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /rates/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /receivers/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /bot_sessions/{id} {
      allow read, write: if false;
    }
    match /chat_settings/{id} {
      allow read, write: if false;
    }

    // ── Database 2.0 domains — server write only ──
    match /staff/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /daily_rates/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /ledger_entries/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /ocr_runs/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /slip_fingerprints/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /images/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /audit_logs/{id} {
      allow read, write: if false;
    }
    match /wallets/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /settlements/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /analytics_daily/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
