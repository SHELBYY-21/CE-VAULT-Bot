{
  "schemaVersion": "2.2",
  "project": "CE VAULT",
  "defaultDecision": "approval",
  "maxReversibleRetries": 2,
  "roles": {
    "DEV": {
      "mode": "write-branch-only",
      "allow": [
        "repo.read",
        "repo.branch.write",
        "test.run",
        "lint.run",
        "typecheck.run",
        "build.run",
        "pull_request.create",
        "preview.verify"
      ],
      "approval": [
        "production.deploy",
        "database.migrate",
        "auth.change",
        "rls.change",
        "production.env.change"
      ],
      "block": [
        "finance.transfer",
        "wallet.private_key.read",
        "production.secret.export",
        "ledger.balance.mutate"
      ]
    },
    "OPS": {
      "mode": "read-mostly",
      "allow": [
        "logs.read",
        "health.read",
        "deployment.status.read",
        "board.production.read",
        "incident.diagnose",
        "rollback.prepare"
      ],
      "approval": [
        "production.redeploy",
        "production.rollback",
        "production.scale",
        "production.env.change",
        "domain.change",
        "dns.change"
      ],
      "block": [
        "production.secret.export",
        "audit.disable",
        "security_control.disable"
      ]
    },
    "RESEARCH": {
      "mode": "read-only",
      "allow": [
        "docs.read",
        "web.research",
        "api.compare",
        "library.review",
        "mcp.review"
      ],
      "approval": [],
      "block": [
        "production.write",
        "production.secret.read",
        "finance.transfer"
      ]
    },
    "FINANCE_ANALYST": {
      "mode": "production-read-only",
      "allow": [
        "board.production.read",
        "ledger.production.read",
        "transactions.production.read",
        "accounts.display.read",
        "rates.production.read",
        "finance.calculate",
        "finance.reconcile.check",
        "finance.anomaly.detect",
        "finance.duplicate.detect",
        "finance.summary"
      ],
      "approval": [],
      "block": [
        "finance.transfer",
        "crypto.send",
        "wallet.sign",
        "wallet.private_key.read",
        "ledger.balance.mutate",
        "ledger.row.delete",
        "transaction.execute",
        "production.data.write",
        "production.secret.read",
        "production.secret.export"
      ]
    }
  },
  "readOnlyProduction": {
    "auto": true,
    "scope": [
      "dashboard_display_data",
      "balances_for_display",
      "ledger_rows",
      "transaction_rows",
      "account_display_metadata",
      "exchange_rates",
      "operational_status"
    ],
    "requirements": [
      "credential_is_read_only_or_api_enforces_read_only",
      "no_wallet_or_transaction_signing_capability",
      "no_secret_export_capability",
      "no_mutation_endpoint_in_board_context"
    ]
  },
  "globalApproval": [
    "production.deploy",
    "database.migrate",
    "auth.change",
    "rls.change",
    "permission.change",
    "production.env.change",
    "database.destructive",
    "domain.change",
    "dns.change",
    "pull_request.merge",
    "git.protected_branch.push",
    "git.main.push",
    "release.deploy",
    "external.data.share",
    "external.message.send",
    "automation.external.activate",
    "security.permission.change",
    "system.install",
    "paid.service.use",
    "major.stack.migrate"
  ],
  "globalBlock": [
    "finance.transfer",
    "crypto.send",
    "wallet.sign",
    "wallet.private_key.read",
    "ledger.balance.mutate",
    "ledger.row.delete",
    "transaction.execute",
    "production.data.write",
    "production.secret.export",
    "audit.disable",
    "security_control.disable",
    "git.main.force_push"
  ],
  "completionEvidence": [
    "branch_or_commit",
    "files_changed",
    "checks_run",
    "check_results",
    "verified_live_state_or_explicitly_unverified_dependencies"
  ],
  "policyVersion": "2.3-draft",
  "projectConfig": {
    "name": "CE VAULT",
    "goal": "Thai-first Telegram fintech operations with read-only monitoring, auditable development and safety-locked settlement",
    "repository": "SHELBYY-21/CE-VAULT-Bot",
    "defaultBranch": "main",
    "workingBranchPrefix": "agent/",
    "workspace": "isolated project worktree or sandbox; verify actual workspace and absence of production credentials before running code"
  },
  "userPreferences": {
    "language": "th",
    "tone": "เป็นกันเอง ตรงประเด็น เข้าใจง่าย",
    "summaryLines": 5,
    "dailyPriorityLimit": 3,
    "explainTechnicalTerms": true
  },
  "delegatedPermissions": {
    "readProjectFiles": true,
    "editProjectFiles": true,
    "createWorkBranch": true,
    "runSafeChecksInSandbox": true,
    "installProjectDependencies": true,
    "commitToWorkBranch": true,
    "pushToWorkBranch": true,
    "openPullRequest": true,
    "scope": "only approved repository and isolated working branch; least privilege, inspect license/install scripts, no production credentials"
  },
  "requiresApproval": [
    "merge_pull_request",
    "push_to_default_or_protected_branch",
    "release_or_deploy",
    "destructive_operations",
    "production_database_changes",
    "security_or_permission_changes",
    "system_wide_installation",
    "paid_services",
    "external_data_sharing",
    "major_stack_migration",
    "production_environment_changes",
    "external_message_or_webhook_activation"
  ],
  "limits": {
    "maxToolCallsPerRun": 20,
    "maxRetriesPerOperation": 2,
    "maxRuntimeMinutes": 15,
    "stopOnSuspectedSecretExposure": true
  },
  "completion": {
    "inspectDiff": true,
    "checkForSecrets": true,
    "runRelevantTests": true,
    "reportUnverifiedItems": true,
    "includeCommitHashWhenAvailable": true,
    "committedDoesNotMeanProductionReady": true
  },
  "executionContract": {
    "intentClassifications": [
      "answer_or_summary",
      "proposal_or_plan",
      "explicit_execution"
    ],
    "questionsDoNotAuthorizeInstallation": true,
    "requireObjectiveAndDoneCriteria": true,
    "preferMinimalReversibleChange": true,
    "workInVerifiableBatches": true,
    "doNotExpandScopeWithoutRequest": true,
    "recordUnrelatedIdeasAsProposals": true,
    "doNotRetryWithoutNewEvidence": true,
    "stopAndReportOnLimits": true,
    "checkForOthersPendingChangesBeforeWrites": true,
    "neverCleanOrResetWorkspaceAutomatically": true,
    "rollbackOnlyTaskChanges": true,
    "stopForOthersChanges": true,
    "completedOnlyWhenVerifiedAndCommittedWhereRequested": true,
    "reportsSeparate": [
      "done",
      "proposed",
      "not_verified"
    ],
    "noFabricatedHashesLinksOrTests": true
  }
}
