# ===== Supabase =====
# หาค่าจาก: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ชื่อ Storage bucket สำหรับเก็บรูปสลิป (default: slips)
SUPABASE_BUCKET=slips

# ===== API Security =====
# สร้างด้วย: openssl rand -hex 32  |  เว้นว่าง = ปิดการตรวจ (dev only)
API_SECRET=

# ===== Telegram Bot =====
# BOT_TOKEN ได้จาก @BotFather
BOT_TOKEN=your-telegram-bot-token
# สตริงสุ่มใดก็ได้ — ส่งตอน register webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# URL ของ deployment (ใช้ตั้ง webhook และสร้างลิงก์)
APP_URL=https://your-project.vercel.app
# chat_id กลุ่ม/ช่องที่รับแจ้งเตือน (เว้นว่าง = ปิด)
NOTIFY_CHAT_ID=

# ===== Rate & Account Defaults =====
DEFAULT_SELL_RATE=35.5
DEFAULT_MARKET_RATE=34.8
# UUID ของ bank_account row ใน Supabase (fallback เมื่อไม่มีค่าใน DB)
DEFAULT_BANK_ACCOUNT_ID=
# threshold แสดง warning ค่าธรรมเนียม (default: 3)
FEE_WARNING_THRESHOLD=3

# ===== OCR =====
# free key: https://ocr.space/ocrapi  (เว้นว่าง = ใช้ Grok แทน)
OCR_SPACE_API_KEY=
# confidence threshold สำหรับ auto-commit สลิป (default: 90)
OCR_AUTO_MIN=90

# ===== Grok / xAI =====
# รับ key ที่: https://console.x.ai
GROK_API_KEY=xai-...
# override model (default: grok-2-vision-1212)
# GROK_MODEL=grok-2-vision-1212

# ===== Telegram Stickers (optional — ทั้งหมดข้ามได้) =====
# วิธีหา file_id: ส่ง sticker เข้าบอท → ดู webhook log ที่ field sticker.file_id
# file_id ของ animated sticker ขึ้นต้นด้วย CAACAg...
STICKER_WELCOME_ID=
STICKER_PROCESSING_ID=
STICKER_OCR_DONE_ID=
STICKER_WAITING_ID=
STICKER_SUCCESS_ID=
STICKER_ERROR_ID=
STICKER_RETRY_ID=
STICKER_THANKYOU_ID=
STICKER_VIP_ID=
STICKER_QUEUE_ID=

# ===== Circle Smart Contract Platform (optional) =====
# Console: https://console.circle.com
# Entity secret: https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_API_KEY=
ENTITY_SECRET=
# override blockchain network (default: ARC-TESTNET)
# CIRCLE_SCP_BLOCKCHAIN=ARC-TESTNET
